<Project>

  <PropertyGroup>
    <BasinPlatforms Condition="'$(BasinPlatforms)' == '' and '$(TargetPlatformIdentifier)' != ''">none</BasinPlatforms>
    <BasinPlatforms Condition="'$(BasinPlatforms)' == ''">linux</BasinPlatforms>
    <BasinPlatforms Condition="'$(BasinPlatforms)' == 'portable'">linux;macos;windows;ios;maccatalyst;android;browser</BasinPlatforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Release' or '$(BasinCounters)' == 'true'">
    <DefineConstants>$(DefineConstants);BASIN_COUNTERS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(BasinDebugOptimize)' != 'false'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <Target Name="BasinOptimizeStamp" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)basin.optimize" Lines="$(Optimize)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="$(IntermediateOutputPath)basin.optimize" />
      <FileWrites Include="$(IntermediateOutputPath)basin.optimize" />
    </ItemGroup>
  </Target>

  <Target Name="BasinAvaloniaImplementationAssemblies"
          Condition="'$(BasinAvaloniaBackend)' == 'true'"
          AfterTargets="ResolveAssemblyReferences"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <_BasinAvaloniaRef Include="@(ReferencePath)"
                         Condition="$([System.String]::Copy('%(ReferencePath.NuGetPackageId)').StartsWith('Avalonia')) and $([System.String]::Copy('%(ReferencePath.Identity)').Replace('\','/').Contains('/ref/'))" />
      <ReferencePath Remove="@(_BasinAvaloniaRef)" />
      <ReferencePath Include="@(_BasinAvaloniaRef->Replace('\','/')->Replace('/ref/', '/lib/'))" />
    </ItemGroup>
    <Error Condition="'@(_BasinAvaloniaRef)' == ''"
           Text="BasinAvaloniaBackend is set but no Avalonia reference assembly was found to swap for its implementation assembly." />
  </Target>

  <Import Project="Sdk.props" Sdk="PublishWithSatoriGC" Version="$(SatoriGcVersion)" Condition="'$(BasinSatori)' == 'true'" />
  <Import Project="Sdk.targets" Sdk="PublishWithSatoriGC" Version="$(SatoriGcVersion)" Condition="'$(BasinSatori)' == 'true'" />

  <ItemGroup Condition="'$(BasinSatori)' == 'true'">
    <_BasinSatoriPackage Include="PublishWithSatoriGC.Runtime.$(RuntimeIdentifier);PublishWithSatoriGC.AotSdk.$(RuntimeIdentifier);PublishWithSatoriGC.AotTools.$(NETCoreSdkRuntimeIdentifier)" />
    <PackageVersion Include="@(_BasinSatoriPackage)" Version="$(SatoriGcVersion)" />
    <PackageReference Update="@(_BasinSatoriPackage)" Version="" />
  </ItemGroup>

  <Target Name="VerifyProtocolXml" BeforeTargets="CoreCompile">
    <Error Condition="'@(AdditionalFiles)' != '' and !Exists('%(AdditionalFiles.Identity)')"
           Text="Protocol XML not found: %(AdditionalFiles.Identity)." />
  </Target>

</Project>
