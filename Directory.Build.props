<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS8002</NoWarn>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <WaylandProtocolsDir>$(RepoRoot)external/wayland-protocols/</WaylandProtocolsDir>
    <WlrProtocolsDir>$(RepoRoot)external/wlr-protocols/</WlrProtocolsDir>
    <RiverProtocolDir>$(RepoRoot)external/river/protocol/</RiverProtocolDir>
    <PlasmaProtocolsDir>$(RepoRoot)external/plasma-wayland-protocols/src/protocols/</PlasmaProtocolsDir>
    <WestonProtocolDir>$(RepoRoot)external/weston/protocol/</WestonProtocolDir>
    <HyprlandProtocolDir>$(RepoRoot)external/hyprland-protocols/protocols/</HyprlandProtocolDir>
    <BasinProtocolDir>$(RepoRoot)protocol/</BasinProtocolDir>
    <IsAotCompatible>true</IsAotCompatible>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(RepoRoot)Key.snk</AssemblyOriginatorKeyFile>
    <PublicKey></PublicKey>
    <Version>0.1.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="WaylandNamespace" />
    <CompilerVisibleProperty Include="WaylandEmitVersionGuards" />
  </ItemGroup>

  <PropertyGroup>
    <BasinPlatforms Condition="'$(BasinPlatforms)' == ''">linux</BasinPlatforms>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute"
                       Condition="$(BasinPlatforms.Contains('linux'))">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute"
                       Condition="$(BasinPlatforms.Contains('macos'))">
      <_Parameter1>macos</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute"
                       Condition="$(BasinPlatforms.Contains('windows'))">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <Authors>drasticactions</Authors>
    <Copyright>Copyright (c) drasticactions</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/drasticactions/basin</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
