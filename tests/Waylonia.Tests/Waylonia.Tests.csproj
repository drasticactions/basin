<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BasinPlatforms>linux;macos;windows</BasinPlatforms>
    <RootNamespace>Waylonia.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../apps/Waylonia/Waylonia.csproj" />
    <ProjectReference Include="../../src/Basin.Avalonia/Basin.Avalonia.csproj" />
    <ProjectReference Include="../../src/Basin.Core/Basin.Core.csproj" />
    <ProjectReference Include="../../src/Basin.Desktop/Basin.Desktop.csproj" />
    <ProjectReference Include="../../src/Basin.Scene/Basin.Scene.csproj" />
    <ProjectReference Include="../../src/Basin.Shell.Xdg/Basin.Shell.Xdg.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Basin.Tests/ShmTestClient.cs" Link="Shared/ShmTestClient.cs" />
    <Compile Include="../Basin.Tests/LeakTracking.cs" Link="Shared/LeakTracking.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
