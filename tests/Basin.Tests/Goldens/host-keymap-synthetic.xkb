xkb_keymap {
    xkb_keycodes {
        minimum = 8;
        maximum = 255;
        <TLDE> = 49;
        <AE01> = 10;
        <AD01> = 24;
        <AD03> = 26;
        <AD11> = 34;
        <LSGT> = 94;
        <SPCE> = 65;
        <ESC> = 9;
        <BKSP> = 22;
        <TAB> = 23;
        <RTRN> = 36;
        <CAPS> = 66;
        <LFSH> = 50;
        <RTSH> = 62;
        <LCTL> = 37;
        <RCTL> = 105;
        <LALT> = 64;
        <LWIN> = 133;
        <RWIN> = 134;
        <MENU> = 135;
        <FK01> = 67;
        <FK02> = 68;
        <FK03> = 69;
        <FK04> = 70;
        <FK05> = 71;
        <FK06> = 72;
        <FK07> = 73;
        <FK08> = 74;
        <FK09> = 75;
        <FK10> = 76;
        <FK11> = 95;
        <FK12> = 96;
        <PRSC> = 107;
        <SCLK> = 78;
        <PAUS> = 127;
        <INS> = 118;
        <DELE> = 119;
        <HOME> = 110;
        <END> = 115;
        <PGUP> = 112;
        <PGDN> = 117;
        <UP> = 111;
        <DOWN> = 116;
        <LEFT> = 113;
        <RGHT> = 114;
        <NMLK> = 77;
        <KPDV> = 106;
        <KPMU> = 63;
        <KPSU> = 82;
        <KPAD> = 86;
        <KPEN> = 104;
        <KP0> = 90;
        <KP1> = 87;
        <KP2> = 88;
        <KP3> = 89;
        <KP4> = 83;
        <KP5> = 84;
        <KP6> = 85;
        <KP7> = 79;
        <KP8> = 80;
        <KP9> = 81;
        <KPDL> = 91;
        <RALT> = 108;
    };
    xkb_types {
        virtual_modifiers NumLock,Alt,LevelThree;
        type "ONE_LEVEL" {
            modifiers = none;
            level_name[Level1] = "Any";
        };
        type "TWO_LEVEL" {
            modifiers = Shift;
            map[Shift] = Level2;
            level_name[Level1] = "Base";
            level_name[Level2] = "Shift";
        };
        type "ALPHABETIC" {
            modifiers = Shift+Lock;
            map[Shift] = Level2;
            map[Lock] = Level2;
            level_name[Level1] = "Base";
            level_name[Level2] = "Caps";
        };
        type "KEYPAD" {
            modifiers = Shift+NumLock;
            map[None] = Level1;
            map[Shift] = Level2;
            map[NumLock] = Level2;
            map[Shift+NumLock] = Level1;
            level_name[Level1] = "Base";
            level_name[Level2] = "Number";
        };
        type "FOUR_LEVEL" {
            modifiers = Shift+LevelThree;
            map[None] = Level1;
            map[Shift] = Level2;
            map[LevelThree] = Level3;
            map[Shift+LevelThree] = Level4;
            level_name[Level1] = "Base";
            level_name[Level2] = "Shift";
            level_name[Level3] = "Alt Base";
            level_name[Level4] = "Shift Alt";
        };
        type "FOUR_LEVEL_SEMIALPHABETIC" {
            modifiers = Shift+Lock+LevelThree;
            map[None] = Level1;
            map[Shift] = Level2;
            map[Lock] = Level2;
            map[LevelThree] = Level3;
            map[Shift+LevelThree] = Level4;
            map[Lock+LevelThree] = Level3;
            map[Lock+Shift+LevelThree] = Level4;
            level_name[Level1] = "Base";
            level_name[Level2] = "Shift";
            level_name[Level3] = "Alt Base";
            level_name[Level4] = "Shift Alt";
        };
    };
    xkb_compat {
        virtual_modifiers NumLock,Alt,LevelThree;
        interpret.repeat = false;
        interpret Shift_L { action = SetMods(modifiers = Shift); };
        interpret Shift_R { action = SetMods(modifiers = Shift); };
        interpret Control_L { action = SetMods(modifiers = Control); };
        interpret Control_R { action = SetMods(modifiers = Control); };
        interpret Alt_L { virtualModifier = Alt; action = SetMods(modifiers = Mod1); };
        interpret Alt_R { virtualModifier = Alt; action = SetMods(modifiers = Mod1); };
        interpret Super_L { action = SetMods(modifiers = Mod4); };
        interpret Super_R { action = SetMods(modifiers = Mod4); };
        interpret Caps_Lock { action = LockMods(modifiers = Lock); };
        interpret Num_Lock {
            virtualModifier = NumLock;
            useModMapMods = level1;
            action = LockMods(modifiers = NumLock);
        };
        interpret ISO_Level3_Shift {
            virtualModifier = LevelThree;
            useModMapMods = level1;
            action = SetMods(modifiers = LevelThree);
        };
        interpret Any + Any { action = SetMods(modifiers = modMapMods); };
    };    xkb_symbols {
        name[Group1] = "synthetic";
        key <TLDE> { type[Group1] = "TWO_LEVEL", [ grave, asciitilde ] };
        key <AE01> { type[Group1] = "FOUR_LEVEL", [ 1, exclam, onesuperior, exclamdown ] };
        key <AD01> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ a, A, ae, AE ] };
        key <AD03> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC", [ e, E, EuroSign, NoSymbol ] };
        key <AD11> { type[Group1] = "TWO_LEVEL", [ dead_acute, dead_diaeresis ] };
        key <LSGT> { type[Group1] = "FOUR_LEVEL", [ less, greater, bar, NoSymbol ] };
        key <SPCE> { type[Group1] = "FOUR_LEVEL", [ space, space, nobreakspace, NoSymbol ] };
        key <ESC> { type[Group1] = "ONE_LEVEL", [ Escape ] };
        key <BKSP> { type[Group1] = "ONE_LEVEL", [ BackSpace ] };
        key <TAB> { type[Group1] = "TWO_LEVEL", [ Tab, ISO_Left_Tab ] };
        key <RTRN> { type[Group1] = "ONE_LEVEL", [ Return ] };
        key <CAPS> { type[Group1] = "ONE_LEVEL", [ Caps_Lock ] };
        key <LFSH> { type[Group1] = "ONE_LEVEL", [ Shift_L ] };
        key <RTSH> { type[Group1] = "ONE_LEVEL", [ Shift_R ] };
        key <LCTL> { type[Group1] = "ONE_LEVEL", [ Control_L ] };
        key <RCTL> { type[Group1] = "ONE_LEVEL", [ Control_R ] };
        key <LALT> { type[Group1] = "ONE_LEVEL", [ Alt_L ] };
        key <LWIN> { type[Group1] = "ONE_LEVEL", [ Super_L ] };
        key <RWIN> { type[Group1] = "ONE_LEVEL", [ Super_R ] };
        key <MENU> { type[Group1] = "ONE_LEVEL", [ Menu ] };
        key <FK01> { type[Group1] = "ONE_LEVEL", [ F1 ] };
        key <FK02> { type[Group1] = "ONE_LEVEL", [ F2 ] };
        key <FK03> { type[Group1] = "ONE_LEVEL", [ F3 ] };
        key <FK04> { type[Group1] = "ONE_LEVEL", [ F4 ] };
        key <FK05> { type[Group1] = "ONE_LEVEL", [ F5 ] };
        key <FK06> { type[Group1] = "ONE_LEVEL", [ F6 ] };
        key <FK07> { type[Group1] = "ONE_LEVEL", [ F7 ] };
        key <FK08> { type[Group1] = "ONE_LEVEL", [ F8 ] };
        key <FK09> { type[Group1] = "ONE_LEVEL", [ F9 ] };
        key <FK10> { type[Group1] = "ONE_LEVEL", [ F10 ] };
        key <FK11> { type[Group1] = "ONE_LEVEL", [ F11 ] };
        key <FK12> { type[Group1] = "ONE_LEVEL", [ F12 ] };
        key <PRSC> { type[Group1] = "ONE_LEVEL", [ Print ] };
        key <SCLK> { type[Group1] = "ONE_LEVEL", [ Scroll_Lock ] };
        key <PAUS> { type[Group1] = "ONE_LEVEL", [ Pause ] };
        key <INS> { type[Group1] = "ONE_LEVEL", [ Insert ] };
        key <DELE> { type[Group1] = "ONE_LEVEL", [ Delete ] };
        key <HOME> { type[Group1] = "ONE_LEVEL", [ Home ] };
        key <END> { type[Group1] = "ONE_LEVEL", [ End ] };
        key <PGUP> { type[Group1] = "ONE_LEVEL", [ Prior ] };
        key <PGDN> { type[Group1] = "ONE_LEVEL", [ Next ] };
        key <UP> { type[Group1] = "ONE_LEVEL", [ Up ] };
        key <DOWN> { type[Group1] = "ONE_LEVEL", [ Down ] };
        key <LEFT> { type[Group1] = "ONE_LEVEL", [ Left ] };
        key <RGHT> { type[Group1] = "ONE_LEVEL", [ Right ] };
        key <NMLK> { type[Group1] = "ONE_LEVEL", [ Num_Lock ] };
        key <KPDV> { type[Group1] = "ONE_LEVEL", [ KP_Divide ] };
        key <KPMU> { type[Group1] = "ONE_LEVEL", [ KP_Multiply ] };
        key <KPSU> { type[Group1] = "ONE_LEVEL", [ KP_Subtract ] };
        key <KPAD> { type[Group1] = "ONE_LEVEL", [ KP_Add ] };
        key <KPEN> { type[Group1] = "ONE_LEVEL", [ KP_Enter ] };
        key <KP0> { type[Group1] = "KEYPAD", [ KP_Insert, KP_0 ] };
        key <KP1> { type[Group1] = "KEYPAD", [ KP_End, KP_1 ] };
        key <KP2> { type[Group1] = "KEYPAD", [ KP_Down, KP_2 ] };
        key <KP3> { type[Group1] = "KEYPAD", [ KP_Next, KP_3 ] };
        key <KP4> { type[Group1] = "KEYPAD", [ KP_Left, KP_4 ] };
        key <KP5> { type[Group1] = "KEYPAD", [ KP_Begin, KP_5 ] };
        key <KP6> { type[Group1] = "KEYPAD", [ KP_Right, KP_6 ] };
        key <KP7> { type[Group1] = "KEYPAD", [ KP_Home, KP_7 ] };
        key <KP8> { type[Group1] = "KEYPAD", [ KP_Up, KP_8 ] };
        key <KP9> { type[Group1] = "KEYPAD", [ KP_Prior, KP_9 ] };
        key <KPDL> { type[Group1] = "KEYPAD", [ KP_Delete, KP_Decimal ] };
        modifier_map Shift { <LFSH>, <RTSH> };
        modifier_map Lock { <CAPS> };
        modifier_map Control { <LCTL>, <RCTL> };
        modifier_map Mod1 { <LALT> };
        modifier_map Mod2 { <NMLK> };
        modifier_map Mod4 { <LWIN>, <RWIN> };
        key <RALT> { type[Group1] = "ONE_LEVEL", [ ISO_Level3_Shift ] };
        modifier_map Mod5 { <RALT> };
    };
};
