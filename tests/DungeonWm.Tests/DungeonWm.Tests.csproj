<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DungeonWm.Tests</RootNamespace>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../samples/DungeonWm/DungeonWm.csproj" />
    <ProjectReference Include="../../src/Basin.Core/Basin.Core.csproj" />
    <ProjectReference Include="../../src/Basin.Scene3D/Basin.Scene3D.csproj" />
    <ProjectReference Include="../../samples/BasinCtl/BasinCtl.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../samples/BasinMcp/BasinMcp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Basin.Tests/Audio/AudioDaemonFixture.cs" Link="Audio/AudioDaemonFixture.cs" />
    <Compile Include="../Basin.Tests/Audio/AudioSignal.cs" Link="Audio/AudioSignal.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
