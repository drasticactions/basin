<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PortComp.iOS</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Choose>
    <When Condition="$([MSBuild]::IsOSPlatform('Linux'))">
      <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <OutputType>Library</OutputType>
        <EnableDefaultItems>false</EnableDefaultItems>
        <IsPublishable>false</IsPublishable>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <TargetFramework></TargetFramework>
        <TargetFrameworks>net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
        <ApplicationId>dev.basin.portcomp</ApplicationId>
        <ApplicationTitle>PortComp</ApplicationTitle>
        <RuntimeIdentifier Condition="$(TargetFramework.Contains('-ios'))">iossimulator-arm64</RuntimeIdentifier>
        <RuntimeIdentifier Condition="$(TargetFramework.Contains('-maccatalyst'))">maccatalyst-arm64</RuntimeIdentifier>
        <PublishAot>true</PublishAot>
        <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
      </PropertyGroup>
      <ItemGroup>
        <ProjectReference Include="../PortComp/PortComp.csproj" />
        <ProjectReference Include="../../../src/Basin.Video.VideoToolbox/Basin.Video.VideoToolbox.csproj" />
        <PackageReference Include="Avalonia.iOS" />
      </ItemGroup>
    </Otherwise>
  </Choose>

</Project>
