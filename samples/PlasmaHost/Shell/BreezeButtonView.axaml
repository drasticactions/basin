<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:PlasmaHost.Shell"
             x:Class="PlasmaHost.Shell.BreezeButtonView"
             x:DataType="shell:BreezeButtonModel"
             Width="{Binding Size}"
             Height="{Binding Size}"
             IsVisible="{Binding IsVisible}">
  <Panel>
    <Ellipse x:Name="Halo"
             Width="{Binding CircleSize}"
             Height="{Binding CircleSize}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             Fill="{Binding Background}"
             Opacity="{Binding HighlightOpacity}" />
    <Image Source="{Binding Icon}"
           Margin="3"
           IsVisible="{Binding HasIcon}" />
    <Path x:Name="Glyph"
          Data="{Binding Glyph}"
          Stroke="{Binding Foreground}"
          StrokeThickness="1.1"
          StrokeLineCap="Round"
          StrokeJoin="Round"
          IsVisible="{Binding ShowsGlyph}" />
  </Panel>
</UserControl>
