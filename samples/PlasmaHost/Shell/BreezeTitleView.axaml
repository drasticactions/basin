<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:PlasmaHost.Shell"
             x:Class="PlasmaHost.Shell.BreezeTitleView"
             x:DataType="shell:BreezeTitleModel">
  <Panel>
    <Border x:Name="Chrome"
            Background="{Binding Background}"
            CornerRadius="{Binding Corners}" />
    <TextBlock x:Name="TitleText"
               Text="{Binding Title}"
               Foreground="{Binding Foreground}"
               FontSize="13"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextTrimming="CharacterEllipsis"
               Margin="{Binding TitleMargin}" />
    <ItemsControl ItemsSource="{Binding Buttons}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.Styles>
        <Style Selector="ContentPresenter" x:DataType="shell:BreezeButtonModel">
          <Setter Property="Canvas.Left" Value="{Binding X}" />
          <Setter Property="Canvas.Top" Value="{Binding Y}" />
        </Style>
      </ItemsControl.Styles>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="shell:BreezeButtonModel">
          <shell:BreezeButtonView />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Panel>
</UserControl>
