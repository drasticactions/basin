<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:PlasmaHost.Shell"
             x:Class="PlasmaHost.Shell.DesktopOsdView"
             x:DataType="shell:DesktopOsdModel">
  <Border Background="{Binding Background}" CornerRadius="6">
    <StackPanel Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
      <TextBlock Text="{Binding Name}"
                 Foreground="{Binding Foreground}"
                 FontSize="20"
                 HorizontalAlignment="Center" />
      <ItemsControl ItemsSource="{Binding Pips}" HorizontalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="shell:DesktopPip">
            <Ellipse Width="8" Height="8"
                     Fill="{Binding Fill}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
