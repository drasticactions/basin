<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shell="clr-namespace:MauiComp.Shell"
             x:Class="MauiComp.Shell.RunPage"
             x:DataType="shell:RunModel"
             BackgroundColor="Transparent">
  <Border Background="{StaticResource CaptionActiveBrush}"
          Stroke="{StaticResource RoyaleCaptionEdge}"
          StrokeThickness="1"
          StrokeShape="RoundRectangle 8,8,0,0"
          Padding="4,0,4,4">
    <Grid RowDefinitions="24,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,21" Margin="4,0,0,0">
        <Label Grid.Column="0" Text="Run" FontSize="13" FontAttributes="Bold" TextColor="White" VerticalOptions="Center">
          <Label.Shadow>
            <Shadow Brush="#80000000" Offset="1,1" Radius="1" />
          </Label.Shadow>
        </Label>
        <Border Grid.Column="1" Style="{StaticResource CaptionButton}" Background="{StaticResource CloseButtonBrush}" Margin="0,1,0,0">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Cancel}" />
          </Border.GestureRecognizers>
          <Grid WidthRequest="11" HeightRequest="11" HorizontalOptions="Center" VerticalOptions="Center">
            <Line X1="1" Y1="1" X2="10" Y2="10" Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round" />
            <Line X1="10" Y1="1" X2="1" Y2="10" Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round" />
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="1" Background="{StaticResource RoyaleButtonFace}" StrokeThickness="0" Padding="12,10">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <Label Grid.Row="0"
                 Text="Type the name of a program, and .NET MAUI will open it for you."
                 FontSize="12"
                 TextColor="{StaticResource RoyaleText}"
                 LineBreakMode="WordWrap" />
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Label Grid.Column="0" Text="Open:" FontSize="12" TextColor="{StaticResource RoyaleText}" VerticalOptions="Center" />
            <Border Grid.Column="1" Background="White" Stroke="#7F9DB9" StrokeThickness="1" Padding="2,0" HeightRequest="24">
              <Entry x:Name="CommandEntry"
                     Text="{Binding Command}"
                     FontSize="12"
                     TextColor="{StaticResource RoyaleText}"
                     BackgroundColor="Transparent"
                     ReturnCommand="{Binding Ok}"
                     VerticalOptions="Center" />
            </Border>
          </Grid>
          <HorizontalStackLayout Grid.Row="2" Spacing="6" HorizontalOptions="End">
            <Border Style="{StaticResource PushButton}">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Ok}" />
              </Border.GestureRecognizers>
              <Label Text="OK" Style="{StaticResource PushButtonText}" />
            </Border>
            <Border Style="{StaticResource PushButton}">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Cancel}" />
              </Border.GestureRecognizers>
              <Label Text="Cancel" Style="{StaticResource PushButtonText}" />
            </Border>
          </HorizontalStackLayout>
        </Grid>
      </Border>
    </Grid>
  </Border>
</ContentPage>
