<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Westonia.Shell"
             x:Class="Westonia.Shell.FrameTitleView"
             x:DataType="shell:FrameModel">
  <Panel>
    <Border Margin="{Binding TitleShadowMargin}"
            CornerRadius="3,3,0,0"
            Background="#40000000" />
    <Border Classes="weston-frame"
            Classes.active="{Binding Active}"
            Margin="{Binding TitleMargin}"
            CornerRadius="3,3,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Classes="weston-title"
                   Text="{Binding Title}"
                   FontSize="14"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="10,0,10,0" />
        <Border Grid.Column="1"
                Classes="weston-close-button"
                Width="19" Height="19"
                Margin="0,0,6,0"
                CornerRadius="9"
                Background="Transparent"
                IsVisible="{Binding HasClose}">
          <Path Classes="weston-close"
                Data="M 0,0 L 7,7 M 7,0 L 0,7"
                StrokeThickness="1.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>
      </Grid>
    </Border>
  </Panel>
</UserControl>
