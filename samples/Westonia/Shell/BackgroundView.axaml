<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Westonia.Shell"
             x:Class="Westonia.Shell.BackgroundView"
             x:DataType="shell:BackgroundModel">
  <Panel Background="{Binding Fill}">
    <Image Source="{Binding Image}"
           IsVisible="{Binding HasImage}"
           Stretch="{Binding Stretch}"
           HorizontalAlignment="{Binding ImageAlignment}"
           VerticalAlignment="{Binding ImageVerticalAlignment}" />
  </Panel>
</UserControl>
