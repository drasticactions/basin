<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EightWm.SignOutView"
             AutomationProperties.Name="Signing out">
  <Grid Background="{DynamicResource SignInTile}">
    <StackPanel Orientation="Horizontal" Spacing="22" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Canvas Width="40" Height="40" VerticalAlignment="Center">
        <Ellipse Width="5" Height="5" Fill="{DynamicResource SignInText}" Canvas.Left="17.5" Canvas.Top="2.5" />
        <Ellipse Width="5" Height="5" Fill="{DynamicResource SignInText}" Canvas.Left="24.5" Canvas.Top="4.25" />
        <Ellipse Width="5" Height="5" Fill="{DynamicResource SignInText}" Canvas.Left="29.9" Canvas.Top="9.1" />
        <Ellipse Width="5" Height="5" Fill="{DynamicResource SignInText}" Canvas.Left="32.4" Canvas.Top="15.9" />
        <Ellipse Width="5" Height="5" Fill="{DynamicResource SignInText}" Canvas.Left="31.4" Canvas.Top="23.1" />
      </Canvas>
      <TextBlock x:Name="Caption" Text="Signing out" FontSize="42" FontWeight="Light" Foreground="{DynamicResource SignInText}" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
