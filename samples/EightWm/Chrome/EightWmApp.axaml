<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:win="https://github.com/avawin"
             x:Class="EightWm.EightWmApp"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://eight-wm/Chrome/CharmGlyphs.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <win:AvaWinTheme Platform="Desktop" />
    <win:AvaWinControlsTheme />
    <Style Selector="Button.pagearrow">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="White" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pagearrow Path">
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Button.pagearrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="BorderBrush" Value="White" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.pagearrow:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="White" />
    </Style>
    <Style Selector="Button.pagearrow:pressed">
      <Setter Property="Foreground" Value="Black" />
    </Style>
  </Application.Styles>
</Application>
