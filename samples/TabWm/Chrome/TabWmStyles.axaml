<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="StackPanel.tab-header">
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <Style Selector="StackPanel.tab-header.drop">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Button.tab-audio">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Opacity" Value="0.8" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Background="Transparent" Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.tab-audio:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.new-tab, Button.strip-menu">
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="TextBox.tab-rename">
    <Setter Property="Padding" Value="2,0" />
  </Style>
  <Style Selector="TextBlock.settings-title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.settings-heading">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.settings-note">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="TextBlock.settings-chord">
    <Setter Property="FontFamily" Value="monospace" />
  </Style>
  <Style Selector="TextBlock.launcher-heading">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="TextBox.launcher-search">
    <Setter Property="FontSize" Value="16" />
  </Style>
</Styles>
