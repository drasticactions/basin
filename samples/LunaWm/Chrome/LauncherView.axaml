<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Basin.UI.Avalonia"
             xmlns:enyo="https://github.com/avaenyo"
             xmlns:luna="using:LunaWm"
             x:Class="LunaWm.LauncherView"
             x:DataType="luna:LauncherModel">
  <UserControl.Styles>
    <Style Selector="ScrollViewer#Scroller /template/ Border#PART_FadeTop">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ScrollViewer#Scroller /template/ Border#PART_FadeBottom">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ScrollViewer#Scroller:fades:scroll-up /template/ Border#PART_FadeTop">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ScrollViewer#Scroller:fades:scroll-down /template/ Border#PART_FadeBottom">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
  <Panel x:Name="Root" Background="#CC101114">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="56" ColumnDefinitions="*,Auto">
        <ItemsControl x:Name="TabBar" ItemsSource="{Binding Tabs}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="luna:LauncherTabModel">
              <Border Classes="tab" Classes.selected="{Binding Selected}" Tag="{Binding}" PointerReleased="OnTab" ui:ChromeAutomation.IsButton="True" ui:ChromeAutomation.Invoked="OnTabInvoked">
                <TextBlock Text="{Binding Name}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Column="1" Classes="done" Margin="0,0,16,0" IsVisible="{Binding Reordering}" PointerReleased="OnDone" ui:ChromeAutomation.IsButton="True" AutomationProperties.Name="Done" ui:ChromeAutomation.Invoked="OnDoneInvoked">
          <TextBlock Text="Done" />
        </Border>
      </Grid>
      <Border DockPanel.Dock="Top" Classes="searchpill" HorizontalAlignment="Center" Margin="0,0,0,10" PointerReleased="OnSearch" ui:ChromeAutomation.IsButton="True" AutomationProperties.Name="Search" ui:ChromeAutomation.Invoked="OnSearchInvoked">
        <TextBlock Text="Just type..." />
      </Border>
      <Grid x:Name="DockRow" DockPanel.Dock="Bottom" Height="88" IsVisible="{Binding Reordering}">
        <Border Classes="dock" />
        <ItemsControl x:Name="DockItems" ItemsSource="{Binding Dock}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="luna:LauncherIconModel">
              <Panel Width="100" Height="72">
                <Image Source="{Binding Icon}" Width="56" Height="56" IsVisible="{Binding HasIcon}" />
                <Border Width="56" Height="56" CornerRadius="12" Background="{Binding Tile}" IsVisible="{Binding !HasIcon}">
                  <TextBlock Text="{Binding Letter}" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" TemplateApplied="OnScrollerTemplate">
        <ScrollViewer.Resources>
          <LinearGradientBrush x:Key="EnyoScrollFadeTopBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#B3101114" />
            <GradientStop Offset="1" Color="#00101114" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="EnyoScrollFadeBottomBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#00101114" />
            <GradientStop Offset="1" Color="#B3101114" />
          </LinearGradientBrush>
        </ScrollViewer.Resources>
        <ItemsControl x:Name="Grid" ItemsSource="{Binding CurrentIcons}" Margin="27,0,27,24">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="luna:LauncherIconModel">
              <Panel Height="118" Margin="0,0,0,10" Background="Transparent" Tag="{Binding}" Opacity="{Binding Opacity}"
                     PointerPressed="OnIconPressed" PointerMoved="OnIconMoved" PointerReleased="OnIconReleased" PointerCaptureLost="OnIconLost"
                     ui:ChromeAutomation.IsButton="True" AutomationProperties.Name="{Binding Name}" ui:ChromeAutomation.Invoked="OnIconInvoked">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="2">
                  <Panel Width="64" Height="64" HorizontalAlignment="Center">
                    <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                    <Border CornerRadius="14" Background="{Binding Tile}" IsVisible="{Binding !HasIcon}">
                      <TextBlock Text="{Binding Letter}" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Panel>
                  <TextBlock Classes="iconlabel" Text="{Binding Name}" />
                </StackPanel>
                <Border Classes="badge" IsVisible="{Binding Reordering}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,0,0,0"
                        Tag="{Binding}" PointerReleased="OnHide" ui:ChromeAutomation.IsButton="True" AutomationProperties.Name="Hide" ui:ChromeAutomation.Invoked="OnHideInvoked">
                  <TextBlock Text="&#x2715;" />
                </Border>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
    <Canvas x:Name="DragLayer" IsHitTestVisible="False">
      <Image x:Name="DragImage" Width="72" Height="72" Opacity="0.9" IsVisible="False" />
    </Canvas>
  </Panel>
</UserControl>
