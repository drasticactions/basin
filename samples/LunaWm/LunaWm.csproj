<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>LunaWm</RootNamespace>
    <AssemblyName>luna-wm</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <BasinAvaloniaBackend>true</BasinAvaloniaBackend>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="luna-wm.toml" LogicalName="luna-wm.toml" />
    <EmbeddedResource Include="shaders/card.frag.spv" LogicalName="card.frag.spv" />
    <EmbeddedResource Include="Assets/Kenney/*.wav" LogicalName="Kenney/%(Filename)%(Extension)" />
  </ItemGroup>

