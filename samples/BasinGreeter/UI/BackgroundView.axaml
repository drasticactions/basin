<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:BasinGreeter.UI"
             x:Class="BasinGreeter.UI.BackgroundView"
             x:DataType="ui:BackgroundModel">
  <Panel Background="{Binding Fill}">
    <Image Source="{Binding Image}" IsVisible="{Binding HasImage}" Stretch="UniformToFill" />
    <TextBlock Text="{Binding Clock}" Foreground="White" FontSize="28" FontWeight="Light"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24,16" />
  </Panel>
</UserControl>
