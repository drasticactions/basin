<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tarn.Android</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>dev.basin.tarn</ApplicationId>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tarn/Tarn.csproj" />
    <ProjectReference Include="../../../src/Basin.Video.MediaCodec/Basin.Video.MediaCodec.csproj" />
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>

</Project>
