<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <RootNamespace>Tarn.Browser</RootNamespace>
    <IsPackable>false</IsPackable>
    <SelfContained>true</SelfContained>
    <UseMonoRuntime>true</UseMonoRuntime>
    <WasmBuildNative>true</WasmBuildNative>
    <EmccMaximumHeapSize>4294967296</EmccMaximumHeapSize>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tarn/Tarn.csproj" />
    <ProjectReference Include="../../../src/Basin.Video.WebCodecs/Basin.Video.WebCodecs.csproj" />
    <PackageReference Include="Avalonia.Browser" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" />
  </ItemGroup>

</Project>
