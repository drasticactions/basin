<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Basin.Render3D.Vulkan</PackageId>
    <RootNamespace>Basin.Render3D.Vulkan</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>The Vulkan renderer for Basin.Scene3D worlds.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Basin.Tests" />
    <ProjectReference Include="../Basin.Core/Basin.Core.csproj" />
    <ProjectReference Include="../Basin.Scene3D/Basin.Scene3D.csproj" />
    <ProjectReference Include="../Basin.Render.Vulkan/Basin.Render.Vulkan.csproj" />
    <PackageReference Include="Silk.NET.Vulkan" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="shaders/*.spv" LogicalName="world.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
