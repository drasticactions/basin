#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D u_texture;
layout(set = 0, binding = 1, r8) uniform writeonly image2D u_luma;
layout(set = 0, binding = 2, rg8) uniform writeonly image2D u_chroma;
layout(push_constant) uniform Push {
    vec4 src;
    vec4 rect;
    vec4 coeffs;
    ivec2 size;
} pc;

vec3 fetch(vec2 luma) {
    vec2 rel = (luma - pc.rect.xy) / pc.rect.zw;
    if (any(lessThan(rel, vec2(0.0))) || any(greaterThanEqual(rel, vec2(1.0)))) {
        return vec3(0.0);
    }
    return textureLod(u_texture, pc.src.xy + rel * pc.src.zw, 0.0).rgb;
}

void main() {
    ivec2 block = ivec2(gl_GlobalInvocationID.xy);
    ivec2 chromaSize = (pc.size + 1) / 2;
    if (block.x >= chromaSize.x || block.y >= chromaSize.y) {
        return;
    }
    float kr = pc.coeffs.x;
    float kb = pc.coeffs.y;
    vec3 weights = vec3(kr, 1.0 - kr - kb, kb);
    bool limited = pc.coeffs.z > 0.5;
    vec3 sum = vec3(0.0);
    for (int dy = 0; dy < 2; dy++) {
        for (int dx = 0; dx < 2; dx++) {
            ivec2 p = block * 2 + ivec2(dx, dy);
            vec3 rgb = fetch(vec2(p) + 0.5);
            sum += rgb;
            if (p.x < pc.size.x && p.y < pc.size.y) {
                float y = dot(rgb, weights);
                y = limited ? (16.0 + 219.0 * y) / 255.0 : y;
                imageStore(u_luma, p, vec4(y, 0.0, 0.0, 1.0));
            }
        }
    }
    vec3 rgb = sum * 0.25;
    float y = dot(rgb, weights);
    float cb = (rgb.b - y) / (2.0 * (1.0 - kb));
    float cr = (rgb.r - y) / (2.0 * (1.0 - kr));
    vec2 c = limited ? (128.0 + 224.0 * vec2(cb, cr)) / 255.0 : vec2(cb, cr) + 0.5;
    imageStore(u_chroma, block, vec4(c, 0.0, 1.0));
}
