<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BasinPlatforms>linux;macos;windows</BasinPlatforms>
    <PackageId>Basin.Render.Avalonia</PackageId>
    <RootNamespace>Basin.Render.Avalonia</RootNamespace>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <Description>Renderer adapter that composites Basin scenes into an Avalonia-leased Skia canvas.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Basin.Core/Basin.Core.csproj" />
    <ProjectReference Include="../Basin.Render.Skia/Basin.Render.Skia.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="mesa-dotnet" />
  </ItemGroup>

</Project>
