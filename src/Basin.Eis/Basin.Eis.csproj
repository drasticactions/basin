<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Basin.Eis</PackageId>
    <RootNamespace>Basin.Eis</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>libei in both directions for Basin: the EIS sender a capture session emulates into, the EIS receiver a remote desktop injects from, and the barrier engine both input-capture fronts share.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Basin.Tests" />
    <InternalsVisibleTo Include="Basin.Hypr.InputCapture" />
    <InternalsVisibleTo Include="Basin.Portal" />
    <ProjectReference Include="../Basin.Core/Basin.Core.csproj" />
    <ProjectReference Include="../Basin.Seat/Basin.Seat.csproj" />
    <PackageReference Include="libei-dotnet" />
  </ItemGroup>

</Project>
