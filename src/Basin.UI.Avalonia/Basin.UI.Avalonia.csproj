<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <BasinPlatforms>portable</BasinPlatforms>
    <PackageId>Basin.UI.Avalonia</PackageId>
    <RootNamespace>Basin.UI.Avalonia</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <Description>An Avalonia windowing backend for Basin compositor chrome.</Description>
    <BasinAvaloniaBackend>true</BasinAvaloniaBackend>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Westonia" />
    <InternalsVisibleTo Include="Westonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Basin.Core/Basin.Core.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="accesskit-dotnet" />
    <PackageReference Include="accesskit-dotnet.avalonia" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

</Project>
