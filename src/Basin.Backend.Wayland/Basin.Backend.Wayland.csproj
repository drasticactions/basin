<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Basin.Backend.Wayland</PackageId>
    <RootNamespace>Basin.Backend.Wayland</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Wayland backend for Basin.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Basin.Tests" />
    <ProjectReference Include="../Basin.Core/Basin.Core.csproj" />
    <PackageReference Include="WaylandSharpest" />
    <AdditionalFiles Include="$(WaylandProtocolsDir)stable/xdg-shell/xdg-shell.xml" WaylandNamespace="Basin.Backend.Wayland.Protocol" />
    <AdditionalFiles Include="$(WaylandProtocolsDir)staging/fractional-scale/fractional-scale-v1.xml" WaylandNamespace="Basin.Backend.Wayland.Protocol" />
    <AdditionalFiles Include="$(WaylandProtocolsDir)unstable/xdg-decoration/xdg-decoration-unstable-v1.xml" WaylandNamespace="Basin.Backend.Wayland.Protocol" />
    <AdditionalFiles Include="$(WaylandProtocolsDir)staging/linux-drm-syncobj/linux-drm-syncobj-v1.xml" WaylandNamespace="Basin.Backend.Wayland.Protocol" />
    <AdditionalFiles Include="$(WaylandProtocolsDir)unstable/pointer-gestures/pointer-gestures-unstable-v1.xml" WaylandNamespace="Basin.Backend.Wayland.Protocol" />
    <AdditionalFiles Include="$(WaylandProtocolsDir)unstable/primary-selection/primary-selection-unstable-v1.xml" WaylandNamespace="Basin.Backend.Wayland.Protocol" />
    <AdditionalFiles Include="$(WaylandProtocolsDir)unstable/pointer-constraints/pointer-constraints-unstable-v1.xml" WaylandNamespace="Basin.Backend.Wayland.Protocol" />
    <AdditionalFiles Include="$(WaylandProtocolsDir)unstable/relative-pointer/relative-pointer-unstable-v1.xml" WaylandNamespace="Basin.Backend.Wayland.Protocol" />
    <AdditionalFiles Include="$(WaylandProtocolsDir)unstable/text-input/text-input-unstable-v3.xml" WaylandNamespace="Basin.Backend.Wayland.Protocol" />
    <AdditionalFiles Include="$(WaylandProtocolsDir)unstable/idle-inhibit/idle-inhibit-unstable-v1.xml" WaylandNamespace="Basin.Backend.Wayland.Protocol" />
    <AdditionalFiles Include="$(WaylandProtocolsDir)staging/xdg-activation/xdg-activation-v1.xml" WaylandNamespace="Basin.Backend.Wayland.Protocol" />
  </ItemGroup>

</Project>
