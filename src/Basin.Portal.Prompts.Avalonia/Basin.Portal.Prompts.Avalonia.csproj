<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Basin.Portal.Prompts.Avalonia</PackageId>
    <RootNamespace>Basin.Portal.Prompts.Avalonia</RootNamespace>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>IPortalPrompts drawn with Avalonia over Basin.UI.Avalonia: the source, device, area, shortcut and confirmation dialogs the xdg-desktop-portal backend asks for, as XAML views a compositor places.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Westonia.Tests" />
    <InternalsVisibleTo Include="MauiComp.Tests" />
    <ProjectReference Include="../Basin.Portal/Basin.Portal.csproj" />
    <ProjectReference Include="../Basin.UI.Avalonia/Basin.UI.Avalonia.csproj" />
    <ProjectReference Include="../Basin.Config/Basin.Config.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>

</Project>
