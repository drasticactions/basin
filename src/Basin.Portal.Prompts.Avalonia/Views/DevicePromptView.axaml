<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Basin.Portal.Prompts.Avalonia"
             x:Class="Basin.Portal.Prompts.Avalonia.DevicePromptView"
             x:DataType="p:DevicePromptModel"
             Focusable="True">
  <UserControl.Styles>
    <StyleInclude Source="avares://Basin.Portal.Prompts.Avalonia/Views/PromptStyles.axaml" />
  </UserControl.Styles>
  <Border Classes="basin-prompt">
    <StackPanel Spacing="12">
      <DockPanel>
        <Image Classes="basin-prompt-icon" DockPanel.Dock="Left" Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
        <StackPanel Spacing="4">
          <TextBlock Classes="basin-prompt-title" Text="{Binding Title}" />
          <TextBlock Classes="basin-prompt-app" Text="{Binding AppLine}" />
        </StackPanel>
      </DockPanel>
      <StackPanel Spacing="4">
        <CheckBox Classes="basin-prompt" Name="KeyboardBox" Content="Keyboard" IsChecked="{Binding Keyboard}" IsVisible="{Binding OffersKeyboard}" />
        <CheckBox Classes="basin-prompt" Name="PointerBox" Content="Pointer" IsChecked="{Binding Pointer}" IsVisible="{Binding OffersPointer}" />
        <CheckBox Classes="basin-prompt" Name="TouchBox" Content="Touchscreen" IsChecked="{Binding Touch}" IsVisible="{Binding OffersTouch}" />
        <CheckBox Classes="basin-prompt" Name="ClipboardBox" Content="Share the clipboard" IsChecked="{Binding Clipboard}" IsVisible="{Binding OffersClipboard}" />
        <CheckBox Classes="basin-prompt" Name="PersistBox" Content="Remember this choice" IsChecked="{Binding Persist}" IsVisible="{Binding OfferPersist}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="basin-prompt-secondary" Name="DenyButton" Content="{Binding DenyLabel}" Command="{Binding Deny}" />
        <Button Classes="basin-prompt-primary" Name="AcceptButton" Content="{Binding AcceptLabel}" Command="{Binding Accept}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
