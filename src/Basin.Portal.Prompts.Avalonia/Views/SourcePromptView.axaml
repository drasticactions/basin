<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Basin.Portal.Prompts.Avalonia"
             x:Class="Basin.Portal.Prompts.Avalonia.SourcePromptView"
             x:DataType="p:SourcePromptModel"
             Focusable="True">
  <UserControl.Styles>
    <StyleInclude Source="avares://Basin.Portal.Prompts.Avalonia/Views/PromptStyles.axaml" />
  </UserControl.Styles>
  <Border Classes="basin-prompt">
    <StackPanel Spacing="12">
      <DockPanel>
        <Image Classes="basin-prompt-icon" DockPanel.Dock="Left" Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
        <StackPanel Spacing="4">
          <TextBlock Classes="basin-prompt-title" Text="{Binding Title}" />
          <TextBlock Classes="basin-prompt-app" Text="{Binding AppLine}" />
        </StackPanel>
      </DockPanel>
      <ListBox Name="Rows" ItemsSource="{Binding Rows}" MaxHeight="280" Background="Transparent"
               SelectionMode="{Binding Multiple, Converter={x:Static p:SelectionModeConverter.Instance}}"
               SelectionChanged="OnSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="p:SourceRowModel">
            <DockPanel>
              <TextBlock Classes="basin-prompt-muted" DockPanel.Dock="Right" Text="{Binding Kind}" VerticalAlignment="Center" />
              <StackPanel>
                <TextBlock Classes="basin-prompt-body" Text="{Binding Title}" />
                <TextBlock Classes="basin-prompt-muted" Text="{Binding Detail}" />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <CheckBox Classes="basin-prompt" Name="PersistBox" Content="Remember this choice" IsChecked="{Binding Persist}" IsVisible="{Binding OfferPersist}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="basin-prompt-secondary" Name="DenyButton" Content="{Binding DenyLabel}" Command="{Binding Deny}" />
        <Button Classes="basin-prompt-primary" Name="AcceptButton" Content="{Binding AcceptLabel}" Command="{Binding Accept}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
