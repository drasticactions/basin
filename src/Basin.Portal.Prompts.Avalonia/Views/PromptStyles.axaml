<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.basin-prompt">
    <Setter Property="Background" Value="#FF2A2D35" />
    <Setter Property="BorderBrush" Value="#FF0A0B0D" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="TextBlock.basin-prompt-title">
    <Setter Property="Foreground" Value="#FFDEE1E6" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Image.basin-prompt-icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.basin-prompt-app">
    <Setter Property="Foreground" Value="#FF9A9EA6" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.basin-prompt-body">
    <Setter Property="Foreground" Value="#FFDEE1E6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.basin-prompt-muted">
    <Setter Property="Foreground" Value="#FF9A9EA6" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="CheckBox.basin-prompt">
    <Setter Property="Foreground" Value="#FFDEE1E6" />
  </Style>
  <Style Selector="Button.basin-prompt-primary">
    <Setter Property="Background" Value="#FF4F7AC0" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="MinWidth" Value="110" />
  </Style>
  <Style Selector="Button.basin-prompt-secondary">
    <Setter Property="Background" Value="#FF3A3E47" />
    <Setter Property="Foreground" Value="#FFDEE1E6" />
    <Setter Property="MinWidth" Value="110" />
  </Style>
</Styles>
