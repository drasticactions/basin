<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <BasinPlatforms>portable</BasinPlatforms>
    <PackageId>Basin.Avalonia.View</PackageId>
    <RootNamespace>Basin.Avalonia</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <Description>The Avalonia controls that place a Basin compositor's output and toplevels in any view, with the lease, the text input and the key map they need, and no host window.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Basin.Avalonia" />
    <InternalsVisibleTo Include="Basin.Tests" />
    <InternalsVisibleTo Include="Waylonia.Tests" />
    <InternalsVisibleTo Include="Waylonia.Ui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Basin.Core/Basin.Core.csproj" />
    <ProjectReference Include="../Basin.Scene/Basin.Scene.csproj" />
    <ProjectReference Include="../Basin.Seat/Basin.Seat.csproj" />
    <ProjectReference Include="../Basin.Shell.Xdg/Basin.Shell.Xdg.csproj" />
    <ProjectReference Include="../Basin.Desktop/Basin.Desktop.csproj" />
    <ProjectReference Include="../Basin.Backend.Hosted/Basin.Backend.Hosted.csproj" />
    <ProjectReference Include="../Basin.Render.Skia/Basin.Render.Skia.csproj" />
    <ProjectReference Include="../Basin.Hosted/Basin.Hosted.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

</Project>
