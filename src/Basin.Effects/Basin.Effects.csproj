<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Basin.Effects</PackageId>
    <RootNamespace>Basin.Effects</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Reference visual effects for Basin, including the GL and Vulkan backdrop blur.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Basin.Core/Basin.Core.csproj" />
    <ProjectReference Include="../Basin.Render.Gl/Basin.Render.Gl.csproj" />
    <ProjectReference Include="../Basin.Render.Vulkan/Basin.Render.Vulkan.csproj" />
    <ProjectReference Include="../Basin.Scene/Basin.Scene.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="shaders/fire.frag.spv" LogicalName="fire.frag.spv" />
    <EmbeddedResource Include="shaders/invert.frag.spv" LogicalName="invert.frag.spv" />
    <EmbeddedResource Include="shaders/colorblind.frag.spv" LogicalName="colorblind.frag.spv" />
    <EmbeddedResource Include="shaders/zoom.frag.spv" LogicalName="zoom.frag.spv" />
    <EmbeddedResource Include="shaders/dim.frag.spv" LogicalName="dim.frag.spv" />
    <EmbeddedResource Include="shaders/blur.vert.spv" LogicalName="blur.vert.spv" />
    <EmbeddedResource Include="shaders/blur_down.frag.spv" LogicalName="blur_down.frag.spv" />
    <EmbeddedResource Include="shaders/blur_up.frag.spv" LogicalName="blur_up.frag.spv" />
    <EmbeddedResource Include="shaders/blur_onscreen.frag.spv" LogicalName="blur_onscreen.frag.spv" />
  </ItemGroup>

</Project>
